{
  "name": "@kidthales/tol-palettes",
  "version": "0.1.1",
  "description": "Paul Tol colour scheme data (values only, with attribution) and generators for CSS, JS/TS, Python, Godot, and GPL/Aseprite.",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "license": "BSD-3-Clause",
  "author": "kidthales",
  "type": "module",
  "main": "./dist/js/index.js",
  "types": "./dist/js/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kidthales/tol-palettes.git"
  },
  "homepage": "https://github.com/kidthales/tol-palettes#readme",
  "bugs": {
    "url": "https://github.com/kidthales/tol-palettes/issues"
  },
  "keywords": [
    "paul-tol",
    "color-schemes",
    "colorblind-safe",
    "palettes",
    "dataviz",
    "accessible",
    "wcag",
    "css",
    "aseprite",
    "godot",
    "python"
  ],
  "files": [
    "dist/css/",
    "dist/js/",
    "dist/json/",
    "dist/py/tol_palettes.py",
    "dist/godot/",
    "dist/gpl/",
    "dist/aseprite/",
    "data/",
    "schema/",
    "NOTICE",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/js/index.d.ts",
      "default": "./dist/js/index.js"
    },
    "./schemes.json": "./dist/json/schemes.json",
    "./css/*": "./dist/css/*",
    "./js/*": "./dist/js/*",
    "./py/*": "./dist/py/*",
    "./godot/*": "./dist/godot/*",
    "./gpl/*": "./dist/gpl/*",
    "./aseprite/*": "./dist/aseprite/*",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "node tools/lint.mjs",
    "test": "npm run lint && node --test",
    "validate": "node tools/validate.mjs",
    "extract": "node tools/extract.mjs",
    "generate:css": "node tools/generate-css.mjs",
    "generate:js": "node tools/generate-js.mjs",
    "generate:py": "node tools/generate-py.mjs",
    "generate:game": "node tools/generate-game.mjs",
    "generate:gallery": "node tools/generate-gallery.mjs",
    "generate": "npm run generate:css && npm run generate:js && npm run generate:py && npm run generate:game && npm run generate:gallery"
  },
  "devDependencies": {
    "ajv": "^8.17.1"
  }
}
